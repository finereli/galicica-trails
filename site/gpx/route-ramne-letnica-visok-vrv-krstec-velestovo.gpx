<trk><name>T-2: Ramne to the H-4 junction</name><desc>T-2 is one of Galičica National Park's harder and longer hiking trails, with more climbing. It's 3.5 km from Ramne to the H-4 junction, with about 456 m of climbing and 5 m of descent in the direction drawn, between 966 m and 1,426 m.</desc><type>T</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>DarkGreen</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>1F7A3D</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.109276" lon="20.836990"><ele>966</ele></trkpt><trkpt lat="41.109465" lon="20.837618"><ele>972</ele></trkpt><trkpt lat="41.110010" lon="20.838170"><ele>974</ele></trkpt><trkpt lat="41.109617" lon="20.839247"><ele>990</ele></trkpt><trkpt lat="41.109658" lon="20.839456"><ele>991</ele></trkpt><trkpt lat="41.109927" lon="20.839791"><ele>992</ele></trkpt><trkpt lat="41.110357" lon="20.840016"><ele>997</ele></trkpt><trkpt lat="41.110727" lon="20.841020"><ele>1016</ele></trkpt><trkpt lat="41.110733" lon="20.841153"><ele>1019</ele></trkpt><trkpt lat="41.110408" lon="20.841220"><ele>1029</ele></trkpt><trkpt lat="41.110447" lon="20.841794"><ele>1035</ele></trkpt><trkpt lat="41.110097" lon="20.842861"><ele>1073</ele></trkpt><trkpt lat="41.110082" lon="20.843335"><ele>1086</ele></trkpt><trkpt lat="41.110269" lon="20.843801"><ele>1094</ele></trkpt><trkpt lat="41.110481" lon="20.843857"><ele>1089</ele></trkpt><trkpt lat="41.110704" lon="20.844268"><ele>1096</ele></trkpt><trkpt lat="41.110596" lon="20.845528"><ele>1122</ele></trkpt><trkpt lat="41.110113" lon="20.846806"><ele>1143</ele></trkpt><trkpt lat="41.110227" lon="20.847094"><ele>1147</ele></trkpt><trkpt lat="41.110798" lon="20.847489"><ele>1149</ele></trkpt><trkpt lat="41.110938" lon="20.848080"><ele>1160</ele></trkpt><trkpt lat="41.110677" lon="20.849196"><ele>1181</ele></trkpt><trkpt lat="41.110936" lon="20.850133"><ele>1182</ele></trkpt><trkpt lat="41.111172" lon="20.850207"