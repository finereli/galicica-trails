<wpt lat="41.045978" lon="20.840728"><name>(no number)</name><desc>Park guidepost. Trails here: H-6, H-4, G-2; guidepost destroyed - signs on the ground with proper directions..</desc><sym>Flag</sym></wpt>
<wpt lat="41.046268" lon="20.839183"><name>P-39</name><desc>Park guidepost. Trails here: H-6, T-4.</desc><sym>Flag</sym></wpt>
<wpt lat="41.046792" lon="20.838838"><name>P-40</name><desc>Park guidepost. Trails here: H-6, T-4.</desc><sym>Flag</sym></wpt>
<wpt lat="41.050560" lon="20.813697"><name>P-65</name><desc>Park guidepost. Trails here: H-5.</desc><sym>Flag</sym></wpt>
