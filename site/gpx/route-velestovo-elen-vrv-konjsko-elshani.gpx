<trk><name>H-5: Elshani to near Velestovo</name><desc>H-5 is one of Galičica National Park's easier and shorter hiking trails. It's 6.9 km from Elshani to near Velestovo, with about 303 m of climbing and 127 m of descent in the direction drawn, between 878 m and 1,181 m.</desc><type>H</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>Red</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>C8202F</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.026276" lon="20.816523"><ele>880</ele></trkpt><trkpt lat="41.026457" lon="20.816247"><ele>879</ele></trkpt><trkpt lat="41.026629" lon="20.815849"><ele>878</ele></trkpt><trkpt lat="41.026702" lon="20.815767"><ele>878</ele></trkpt><trkpt lat="41.026860" lon="20.815816"><ele>882</ele></trkpt><trkpt lat="41.026974" lon="20.815939"><ele>885</ele></trkpt><trkpt lat="41.026975" lon="20.816151"><ele>886</ele></trkpt><trkpt lat="41.027016" lon="20.816215"><ele>887</ele></trkpt><trkpt lat="41.027175" lon="20.816315"><ele>890</ele></trkpt><trkpt lat="41.027295" lon="20.816319"><ele>892</ele></trkpt><trkpt lat="41.027716" lon="20.816550"><ele>898</ele></trkpt><trkpt lat="41.027827" lon="20.816477"><ele>898</ele></trkpt><trkpt lat="41.027859" lon="20.816312"><ele>897</ele></trkpt><trkpt lat="41.028270" lon="20.816206"><ele>902</ele></trkpt><trkpt lat="41.028621" lon="20.816244"><ele>903</ele></trkpt><trkpt lat="41.028893" lon="20.816565"><ele>906</ele></trkpt><trkpt lat="41.029093" lon="20.816579"><ele>905</ele></trkpt><trkpt lat="41.029419" lon="20.816476"><ele>908</ele></trkpt><trkpt lat="41.029724" lon="20.816519"><ele>909</ele></trkpt><trkpt lat="41.029810" lon="20.816585"><ele>909</ele></trkpt><trkpt lat="41.029942" lon="20.816910"><ele>912</ele></trkpt><trkpt lat="41.030213" lon="20.817074"><ele>911</ele></trkpt><trkpt lat="41.030480" lon="20.817044"><ele>912</ele></trkpt><trkpt lat="41.030850" lon="20.816897"><ele>915</ele></trkpt><trkpt lat="41.0