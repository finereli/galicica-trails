<trk><name>T-3: Velestovo to the MTB-3 junction</name><desc>T-3 is one of Galičica National Park's harder and longer hiking trails, with more climbing. It runs 4.0 km from Velestovo to the MTB-3 junction, climbing about 482 m and descending 81 m in the direction drawn, between 1,072 m and 1,555 m.</desc><type>T</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>DarkGreen</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>1F7A3D</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.083568" lon="20.828084"><ele>1072</ele></trkpt><trkpt lat="41.083543" lon="20.828075"><ele>1072</ele></trkpt><trkpt lat="41.083324" lon="20.828272"><ele>1076</ele></trkpt><trkpt lat="41.083154" lon="20.828460"><ele>1083</ele></trkpt><trkpt lat="41.082851" lon="20.828405"><ele>1088</ele></trkpt><trkpt lat="41.082723" lon="20.828435"><ele>1092</ele></trkpt><trkpt lat="41.082495" lon="20.828538"><ele>1096</ele></trkpt><trkpt lat="41.082351" lon="20.828835"><ele>1105</ele></trkpt><trkpt lat="41.082225" lon="20.828994"><ele>1110</ele></trkpt><trkpt lat="41.081841" lon="20.829007"><ele>1114</ele></trkpt><trkpt lat="41.081694" lon="20.829174"><ele>1116</ele></trkpt><trkpt lat="41.081604" lon="20.829330"><ele>1120</ele></trkpt><trkpt lat="41.081568" lon="20.829830"><ele>1133</ele></trkpt><trkpt lat="41.081504" lon="20.830017"><ele>1138</ele></trkpt><trkpt lat="41.081427" lon="20.830064"><ele>1139</ele></trkpt><trkpt lat="41.081239" lon="20.830164"><ele>1142</ele></trkpt><trkpt lat="41.080890" lon="20.830301"><ele>1144</ele></trkpt><trkpt lat="41.080656" lon="20.830503"><ele>1146</ele></trkpt><trkpt lat="41.080439" lon="20.830595"><ele>1146</ele></trkpt><trkpt lat="41.080365" lon="20.830665"><ele>1148</ele></trkpt><trkpt lat="41.080202" lon="20.831062"><ele>1157</ele></trkpt><trkpt lat="41.080131" lon="20.831403"><ele>1162</ele></trkpt><trkpt lat="41.080096" lon="20.831812"><ele>1169</ele></trkpt><trkpt lat="41.080127