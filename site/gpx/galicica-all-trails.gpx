<trk><name>H-2: near Racha to Sveti Trojca Arhierei</name><desc>H-2 is one of Galičica National Park's easier and shorter hiking trails. It runs 1.1 km from near Racha to Sveti Trojca Arhierei, climbing about 138 m and descending 0 m in the direction drawn, between 765 m and 914 m.</desc><type>H</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>Red</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>C8202F</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.088450" lon="20.814921"><ele>765</ele></trkpt><trkpt lat="41.088037" lon="20.814863"><ele>770</ele></trkpt><trkpt lat="41.087350" lon="20.815395"><ele>782</ele></trkpt><trkpt lat="41.086750" lon="20.817042"><ele>799</ele></trkpt><trkpt lat="41.086248" lon="20.817725"><ele>809</ele></trkpt><trkpt lat="41.086347" lon="20.817822"><ele>809</ele></trkpt><trkpt lat="41.086036" lon="20.818718"><ele>820</ele></trkpt><trkpt lat="41.085589" lon="20.819242"><ele>833</ele></trkpt><trkpt lat="41.085845" lon="20.819399"><ele>837</ele></trkpt><trkpt lat="41.086889" lon="20.819013"><ele>857</ele></trkpt><trkpt lat="41.086865" lon="20.819071"><ele>858</ele></trkpt><trkpt lat="41.086073" lon="20.820489"><ele>877</ele></trkpt><trkpt lat="41.085766" lon="20.820572"><ele>873</ele></trkpt><trkpt lat="41.085456" lon="20.821150"><ele>885</ele></trkpt><trkpt lat="41.086988" lon="20.820659"><ele>914</ele></trkpt></trkseg></trk>
