<trk><name>T-6: near Oteshevo to the MTB-3 junction</name><desc>T-6 is one of Galičica National Park's harder and longer hiking trails, with more climbing. It runs 11.5 km from near Oteshevo to the MTB-3 junction, climbing about 677 m and descending 76 m in the direction drawn, between 867 m and 1,524 m.</desc><type>T</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>DarkGreen</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>1F7A3D</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="40.985027" lon="20.918126"><ele>872</ele></trkpt><trkpt lat="40.985299" lon="20.917781"><ele>875</ele></trkpt><trkpt lat="40.985813" lon="20.918155"><ele>867</ele></trkpt><trkpt lat="40.987078" lon="20.917776"><ele>875</ele></trkpt><trkpt lat="40.987219" lon="20.917497"><ele>877</ele></trkpt><trkpt lat="40.987681" lon="20.917113"><ele>882</ele></trkpt><trkpt lat="40.988313" lon="20.916228"><ele>894</ele></trkpt><trkpt lat="40.989186" lon="20.915496"><ele>904</ele></trkpt><trkpt lat="40.989569" lon="20.915367"><ele>907</ele></trkpt><trkpt lat="40.989734" lon="20.915598"><ele>908</ele></trkpt><trkpt lat="40.989810" lon="20.915959"><ele>908</ele></trkpt><trkpt lat="40.990152" lon="20.916264"><ele>905</ele></trkpt><trkpt lat="40.991327" lon="20.916151"><ele>909</ele></trkpt><trkpt lat="40.991643" lon="20.916354"><ele>910</ele></trkpt><trkpt lat="40.991980" lon="20.916758"><ele>911</ele></trkpt><trkpt lat="40.992245" lon="20.916860"><ele>911</ele></trkpt><trkpt lat="40.992971" lon="20.916726"><ele>912</ele></trkpt><trkpt lat="40.993521" lon="20.916407"><ele>916</ele></trkpt><trkpt lat="40.994364" lon="20.916154"><ele>925</ele></trkpt><trkpt lat="40.995089" lon="20.916302"><ele>930</ele></trkpt><trkpt lat="40.995267" lon="20.916447"><ele>930</ele></trkpt><trkpt lat="40.996219" lon="20.916476"><ele>939</ele></trkpt><trkpt lat="40.997209" lon="20.917352"><ele>940</ele></trkpt><trkpt lat="40.997857" lon="20.917710