<trk><name>H-1: near Velestovo to near Racha</name><desc>H-1 is one of Galičica National Park's easier and shorter hiking trails. It runs 1.7 km from near Velestovo to near Racha, climbing about 15 m and descending 134 m in the direction drawn, between 880 m and 1,001 m.</desc><type>H</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>Red</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>C8202F</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.078880" lon="20.823933"><ele>1001</ele></trkpt><trkpt lat="41.078829" lon="20.823834"><ele>1000</ele></trkpt><trkpt lat="41.079070" lon="20.823939"><ele>996</ele></trkpt><trkpt lat="41.079143" lon="20.824014"><ele>996</ele></trkpt><trkpt lat="41.079382" lon="20.823990"><ele>992</ele></trkpt><trkpt lat="41.079452" lon="20.824017"><ele>991</ele></trkpt><trkpt lat="41.079647" lon="20.824039"><ele>986</ele></trkpt><trkpt lat="41.079985" lon="20.824153"><ele>982</ele></trkpt><trkpt lat="41.080190" lon="20.824256"><ele>985</ele></trkpt><trkpt lat="41.080386" lon="20.824303"><ele>985</ele></trkpt><trkpt lat="41.080640" lon="20.824406"><ele>987</ele></trkpt><trkpt lat="41.080770" lon="20.824284"><ele>983</ele></trkpt><trkpt lat="41.080854" lon="20.824264"><ele>982</ele></trkpt><trkpt lat="41.081033" lon="20.824165"><ele>978</ele></trkpt><trkpt lat="41.081220" lon="20.824090"><ele>977</ele></trkpt><trkpt lat="41.081650" lon="20.824003"><ele>973</ele></trkpt><trkpt lat="41.081888" lon="20.823991"><ele>969</ele></trkpt><trkpt lat="41.082225" lon="20.824022"><ele>968</ele></trkpt><trkpt lat="41.082598" lon="20.823982"><ele>959</ele></trkpt><trkpt lat="41.082922" lon="20.824024"><ele>959</ele></trkpt><trkpt lat="41.083292" lon="20.823954"><ele>955</ele></trkpt><trkpt lat="41.083472" lon="20.823881"><ele>954</ele></trkpt><trkpt lat="41.083743" lon="20.823659"><ele>948</ele></trkpt><trkpt lat="41.084091" lon="20.823460"><ele>947</ele></trkpt><trkpt lat="41