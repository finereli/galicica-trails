<trk><name>G-6: Galičica pass (Lipova Livada) to Magaro peak</name><desc>G-6 is one of Galičica National Park's high ridge trails above 1,600 m. It runs 5.2 km from Galičica pass (Lipova Livada) to Magaro peak, climbing about 670 m and descending 321 m in the direction drawn, between 1,567 m and 2,247 m.</desc><type>G</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>Yellow</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>D4A20B</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="40.953837" lon="20.829059"><ele>1570</ele></trkpt><trkpt lat="40.953784" lon="20.828962"><ele>1569</ele></trkpt><trkpt lat="40.953621" lon="20.828826"><ele>1567</ele></trkpt><trkpt lat="40.953407" lon="20.828647"><ele>1569</ele></trkpt><trkpt lat="40.953346" lon="20.828597"><ele>1570</ele></trkpt><trkpt lat="40.953103" lon="20.828399"><ele>1573</ele></trkpt><trkpt lat="40.952681" lon="20.828062"><ele>1571</ele></trkpt><trkpt lat="40.952524" lon="20.827911"><ele>1572</ele></trkpt><trkpt lat="40.952459" lon="20.827761"><ele>1573</ele></trkpt><trkpt lat="40.952329" lon="20.827171"><ele>1581</ele></trkpt><trkpt lat="40.952252" lon="20.827154"><ele>1584</ele></trkpt><trkpt lat="40.952192" lon="20.827154"><ele>1587</ele></trkpt><trkpt lat="40.952167" lon="20.827256"><ele>1587</ele></trkpt><trkpt lat="40.951806" lon="20.827981"><ele>1599</ele></trkpt><trkpt lat="40.951660" lon="20.828299"><ele>1604</ele></trkpt><trkpt lat="40.951534" lon="20.828734"><ele>1610</ele></trkpt><trkpt lat="40.951553" lon="20.828987"><ele>1608</ele></trkpt><trkpt lat="40.951567" lon="20.829218"><ele>1605</ele></trkpt><trkpt lat="40.951511" lon="20.829422"><ele>1607</ele></trkpt><trkpt lat="40.951418" lon="20.829628"><ele>1609</ele></trkpt><trkpt lat="40.951296" lon="20.829907"><ele>1610</ele></trkpt><trkpt lat="40.951146" lon="20.829530"><ele>1616</ele></trkpt><trkpt lat="40.951070" lon="20.829329"><ele>1621</ele></trkpt><trkpt lat="40.95