<trk><name>G-3: the H-5 junction to near Shipokno</name><desc>G-3 is one of Galičica National Park's high ridge trails above 1,600 m. It runs 0.8 km from the H-5 junction to near Shipokno, climbing about 22 m and descending 0 m in the direction drawn, between 1,178 m and 1,209 m.</desc><type>G</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>Yellow</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>D4A20B</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.065886" lon="20.820167"><ele>1182</ele></trkpt><trkpt lat="41.065973" lon="20.819825"><ele>1182</ele></trkpt><trkpt lat="41.066148" lon="20.819405"><ele>1180</ele></trkpt><trkpt lat="41.066363" lon="20.819296"><ele>1178</ele></trkpt><trkpt lat="41.066579" lon="20.819361"><ele>1178</ele></trkpt><trkpt lat="41.066760" lon="20.819472"><ele>1181</ele></trkpt><trkpt lat="41.066950" lon="20.819480"><ele>1181</ele></trkpt><trkpt lat="41.067111" lon="20.819412"><ele>1180</ele></trkpt><trkpt lat="41.067310" lon="20.819436"><ele>1181</ele></trkpt><trkpt lat="41.067491" lon="20.819529"><ele>1182</ele></trkpt><trkpt lat="41.067634" lon="20.819634"><ele>1181</ele></trkpt><trkpt lat="41.067837" lon="20.819478"><ele>1178</ele></trkpt><trkpt lat="41.068083" lon="20.819571"><ele>1178</ele></trkpt><trkpt lat="41.068576" lon="20.819386"><ele>1180</ele></trkpt><trkpt lat="41.068687" lon="20.819399"><ele>1183</ele></trkpt><trkpt lat="41.068875" lon="20.819294"><ele>1184</ele></trkpt><trkpt lat="41.068962" lon="20.819377"><ele>1188</ele></trkpt><trkpt lat="41.068954" lon="20.819341"><ele>1187</ele></trkpt><trkpt lat="41.068977" lon="20.819263"><ele>1185</ele></trkpt><trkpt lat="41.069035" lon="20.819369"><ele>1189</ele></trkpt><trkpt lat="41.069264" lon="20.819384"><ele>1191</ele></trkpt><trkpt lat="41.069564" lon="20.819347"><ele>1193</ele></trkpt><trkpt lat="41.069777" lon="20.819407"><ele>1195</ele></trkpt><trkpt lat="41.069932" lon="20.819523"><el