<trk><name>H-6: Konjsko to above Elshani (1,469 m)</name><desc>H-6 is one of Galičica National Park's easier and shorter hiking trails. It runs 5.7 km from Konjsko to above Elshani (1,469 m), climbing about 426 m and descending 39 m in the direction drawn, between 1,085 m and 1,507 m.</desc><type>H</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>Red</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>C8202F</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.050734" lon="20.813903"><ele>1085</ele></trkpt><trkpt lat="41.050020" lon="20.814351"><ele>1095</ele></trkpt><trkpt lat="41.049093" lon="20.813992"><ele>1111</ele></trkpt><trkpt lat="41.048922" lon="20.814390"><ele>1113</ele></trkpt><trkpt lat="41.049107" lon="20.815220"><ele>1123</ele></trkpt><trkpt lat="41.049629" lon="20.816208"><ele>1141</ele></trkpt><trkpt lat="41.049671" lon="20.816508"><ele>1145</ele></trkpt><trkpt lat="41.049801" lon="20.816579"><ele>1152</ele></trkpt><trkpt lat="41.049792" lon="20.817050"><ele>1158</ele></trkpt><trkpt lat="41.049895" lon="20.817408"><ele>1166</ele></trkpt><trkpt lat="41.050438" lon="20.818288"><ele>1197</ele></trkpt><trkpt lat="41.050299" lon="20.818583"><ele>1197</ele></trkpt><trkpt lat="41.050455" lon="20.819293"><ele>1211</ele></trkpt><trkpt lat="41.050135" lon="20.819960"><ele>1214</ele></trkpt><trkpt lat="41.050106" lon="20.820072"><ele>1217</ele></trkpt><trkpt lat="41.050083" lon="20.820145"><ele>1219</ele></trkpt><trkpt lat="41.050060" lon="20.820217"><ele>1221</ele></trkpt><trkpt lat="41.050037" lon="20.820290"><ele>1223</ele></trkpt><trkpt lat="41.050037" lon="20.820362"><ele>1224</ele></trkpt><trkpt lat="41.050037" lon="20.820448"><ele>1226</ele></trkpt><trkpt lat="41.050037" lon="20.820520"><ele>1227</ele></trkpt><trkpt lat="41.050037" lon="20.820606"><ele>1228</ele></trkpt><trkpt lat="41.050004" lon="20.820540"><ele>1228</ele></trkpt><trkpt lat="41.049767" lon="20.821173"><