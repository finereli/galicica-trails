<trk><name>MTB-3: the MTB-2 junction to the MTB-2 junction</name><desc>MTB-3 is one of Galičica National Park's mountain bike trails, several of which link the hiking routes. It runs 7.3 km from the MTB-2 junction to the MTB-2 junction, climbing about 145 m and descending 152 m in the direction drawn, between 1,438 m and 1,559 m.</desc><type>MTB</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>DarkBlue</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>24357F</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.049274" lon="20.858220"><ele>1447</ele></trkpt><trkpt lat="41.049068" lon="20.859504"><ele>1454</ele></trkpt><trkpt lat="41.049590" lon="20.861436"><ele>1453</ele></trkpt><trkpt lat="41.049502" lon="20.862951"><ele>1464</ele></trkpt><trkpt lat="41.049701" lon="20.864000"><ele>1468</ele></trkpt><trkpt lat="41.050428" lon="20.865061"><ele>1481</ele></trkpt><trkpt lat="41.050471" lon="20.867169"><ele>1509</ele></trkpt><trkpt lat="41.051105" lon="20.868431"><ele>1526</ele></trkpt><trkpt lat="41.050942" lon="20.869562"><ele>1542</ele></trkpt><trkpt lat="41.050461" lon="20.870042"><ele>1556</ele></trkpt><trkpt lat="41.051039" lon="20.870328"><ele>1552</ele></trkpt><trkpt lat="41.051136" lon="20.870658"><ele>1554</ele></trkpt><trkpt lat="41.050896" lon="20.871733"><ele>1547</ele></trkpt><trkpt lat="41.050821" lon="20.873641"><ele>1545</ele></trkpt><trkpt lat="41.051332" lon="20.875919"><ele>1550</ele></trkpt><trkpt lat="41.051293" lon="20.876593"><ele>1552</ele></trkpt><trkpt lat="41.051577" lon="20.877561"><ele>1558</ele></trkpt><trkpt lat="41.051635" lon="20.877553"><ele>1559</ele></trkpt><trkpt lat="41.051816" lon="20.877887"><ele>1557</ele></trkpt><trkpt lat="41.052145" lon="20.878107"><ele>1556</ele></trkpt><trkpt lat="41.052072" lon="20.878274"><ele>1552</ele></trkpt><trkpt lat="41.051771" lon="20.878463"><ele>1543</ele></trkpt><trkpt lat="41.051325" lon="20.878619"><ele>1533<