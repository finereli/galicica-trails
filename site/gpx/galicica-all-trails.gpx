<trk><name>G-7: Dva Javora to Tomoros peak</name><desc>G-7 is one of Galičica National Park's high ridge trails above 1,600 m. It runs 1.5 km from Dva Javora to Tomoros peak, climbing about 186 m and descending 11 m in the direction drawn, between 1,481 m and 1,666 m.</desc><type>G</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>Yellow</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>D4A20B</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="40.987248" lon="20.868157"><ele>1489</ele></trkpt><trkpt lat="40.987232" lon="20.868115"><ele>1489</ele></trkpt><trkpt lat="40.987205" lon="20.868095"><ele>1489</ele></trkpt><trkpt lat="40.987052" lon="20.868251"><ele>1490</ele></trkpt><trkpt lat="40.987012" lon="20.868294"><ele>1490</ele></trkpt><trkpt lat="40.986964" lon="20.868305"><ele>1491</ele></trkpt><trkpt lat="40.986901" lon="20.868402"><ele>1491</ele></trkpt><trkpt lat="40.986838" lon="20.868613"><ele>1490</ele></trkpt><trkpt lat="40.986727" lon="20.868941"><ele>1488</ele></trkpt><trkpt lat="40.986605" lon="20.869305"><ele>1486</ele></trkpt><trkpt lat="40.986568" lon="20.869544"><ele>1484</ele></trkpt><trkpt lat="40.986486" lon="20.869683"><ele>1484</ele></trkpt><trkpt lat="40.986457" lon="20.869751"><ele>1483</ele></trkpt><trkpt lat="40.986342" lon="20.870045"><ele>1481</ele></trkpt><trkpt lat="40.986165" lon="20.870342"><ele>1481</ele></trkpt><trkpt lat="40.986093" lon="20.870531"><ele>1482</ele></trkpt><trkpt lat="40.986062" lon="20.870585"><ele>1483</ele></trkpt><trkpt lat="40.986026" lon="20.870638"><ele>1484</ele></trkpt><trkpt lat="40.985916" lon="20.870916"><ele>1488</ele></trkpt><trkpt lat="40.985779" lon="20.871110"><ele>1491</ele></trkpt><trkpt lat="40.985759" lon="20.871217"><ele>1492</ele></trkpt><trkpt lat="40.985754" lon="20.871229"><ele>1492</ele></trkpt><trkpt lat="40.985626" lon="20.871491"><ele>1495</ele></trkpt><trkpt lat="40.985554" lon="20.871641"><ele>1498</ele>