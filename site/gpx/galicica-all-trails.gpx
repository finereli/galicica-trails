<trk><name>T-1: St Parascheva to the H-4 junction</name><desc>T-1 is one of Galičica National Park's harder and longer hiking trails, with more climbing. It runs 6.1 km from St Parascheva to the H-4 junction, climbing about 682 m and descending 85 m in the direction drawn, between 770 m and 1,457 m.</desc><type>T</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>DarkGreen</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>1F7A3D</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.129361" lon="20.840295"><ele>828</ele></trkpt><trkpt lat="41.129361" lon="20.840292"><ele>828</ele></trkpt><trkpt lat="41.129294" lon="20.839955"><ele>824</ele></trkpt><trkpt lat="41.129239" lon="20.839740"><ele>819</ele></trkpt><trkpt lat="41.129152" lon="20.839730"><ele>820</ele></trkpt><trkpt lat="41.129140" lon="20.839676"><ele>818</ele></trkpt><trkpt lat="41.129191" lon="20.839455"><ele>811</ele></trkpt><trkpt lat="41.129257" lon="20.839469"><ele>811</ele></trkpt><trkpt lat="41.129442" lon="20.839371"><ele>809</ele></trkpt><trkpt lat="41.129380" lon="20.839173"><ele>803</ele></trkpt><trkpt lat="41.129254" lon="20.838943"><ele>798</ele></trkpt><trkpt lat="41.129056" lon="20.838433"><ele>791</ele></trkpt><trkpt lat="41.128944" lon="20.837880"><ele>784</ele></trkpt><trkpt lat="41.128868" lon="20.837642"><ele>779</ele></trkpt><trkpt lat="41.128867" lon="20.837115"><ele>773</ele></trkpt><trkpt lat="41.128845" lon="20.837033"><ele>773</ele></trkpt><trkpt lat="41.128678" lon="20.837002"><ele>775</ele></trkpt><trkpt lat="41.128459" lon="20.836923"><ele>776</ele></trkpt><trkpt lat="41.128099" lon="20.836652"><ele>771</ele></trkpt><trkpt lat="41.127837" lon="20.836519"><ele>770</ele></trkpt><trkpt lat="41.127609" lon="20.836269"><ele>770</ele></trkpt><trkpt lat="41.127462" lon="20.836260"><ele>771</ele></trkpt><trkpt lat="41.127293" lon="20.836475"><ele>773</ele></trkpt><trkpt lat="41.127045" lon="20.836985"><el