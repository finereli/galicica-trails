<trk><name>H-7: Sharbojca mountain house (Asan Djura) to Samotska Dupka Cave</name><desc>H-7 is one of Galičica National Park's easier and shorter hiking trails. It runs 2.6 km from Sharbojca mountain house (Asan Djura) to Samotska Dupka Cave, climbing about 51 m and descending 113 m in the direction drawn, between 1,404 m and 1,505 m.</desc><type>H</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>Red</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>C8202F</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.027117" lon="20.865620"><ele>1466</ele></trkpt><trkpt lat="41.028152" lon="20.863735"><ele>1485</ele></trkpt><trkpt lat="41.028403" lon="20.862516"><ele>1479</ele></trkpt><trkpt lat="41.028245" lon="20.861974"><ele>1483</ele></trkpt><trkpt lat="41.027833" lon="20.861430"><ele>1483</ele></trkpt><trkpt lat="41.027700" lon="20.861052"><ele>1486</ele></trkpt><trkpt lat="41.027224" lon="20.857310"><ele>1483</ele></trkpt><trkpt lat="41.027206" lon="20.857292"><ele>1483</ele></trkpt><trkpt lat="41.027230" lon="20.857271"><ele>1483</ele></trkpt><trkpt lat="41.027338" lon="20.857164"><ele>1484</ele></trkpt><trkpt lat="41.027459" lon="20.856976"><ele>1484</ele></trkpt><trkpt lat="41.027740" lon="20.856430"><ele>1485</ele></trkpt><trkpt lat="41.027787" lon="20.855908"><ele>1481</ele></trkpt><trkpt lat="41.027758" lon="20.855358"><ele>1481</ele></trkpt><trkpt lat="41.027584" lon="20.854764"><ele>1477</ele></trkpt><trkpt lat="41.027774" lon="20.854070"><ele>1475</ele></trkpt><trkpt lat="41.028112" lon="20.853627"><ele>1475</ele></trkpt><trkpt lat="41.028739" lon="20.853073"><ele>1470</ele></trkpt><trkpt lat="41.029511" lon="20.852402"><ele>1477</ele></trkpt><trkpt lat="41.029573" lon="20.852327"><ele>1476</ele></trkpt><trkpt lat="41.029594" lon="20.852316"><ele>1475</ele></trkpt><trkpt lat="41.029617" lon="20.852299"><ele>1475</ele></trkpt><trkpt lat="41.029633" lon="20.852280"><ele>1475</