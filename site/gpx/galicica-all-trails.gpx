<trk><name>MTB-8: above Trpejca (996 m) to above Trpejca (889 m)</name><desc>MTB-8 is one of Galičica National Park's mountain bike trails, several of which link the hiking routes. It runs 1.5 km from above Trpejca (996 m) to above Trpejca (889 m), climbing about 24 m and descending 129 m in the direction drawn, between 865 m and 997 m.</desc><type>MTB</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>DarkBlue</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>24357F</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="40.951152" lon="20.780689"><ele>996</ele></trkpt><trkpt lat="40.951042" lon="20.780716"><ele>997</ele></trkpt><trkpt lat="40.950832" lon="20.780781"><ele>996</ele></trkpt><trkpt lat="40.950723" lon="20.780664"><ele>995</ele></trkpt><trkpt lat="40.950607" lon="20.780626"><ele>993</ele></trkpt><trkpt lat="40.950361" lon="20.780622"><ele>990</ele></trkpt><trkpt lat="40.950185" lon="20.780448"><ele>985</ele></trkpt><trkpt lat="40.950061" lon="20.780430"><ele>985</ele></trkpt><trkpt lat="40.949743" lon="20.780339"><ele>981</ele></trkpt><trkpt lat="40.949554" lon="20.780319"><ele>980</ele></trkpt><trkpt lat="40.949271" lon="20.780312"><ele>979</ele></trkpt><trkpt lat="40.949024" lon="20.780319"><ele>977</ele></trkpt><trkpt lat="40.948711" lon="20.780335"><ele>974</ele></trkpt><trkpt lat="40.948445" lon="20.780144"><ele>965</ele></trkpt><trkpt lat="40.948182" lon="20.779963"><ele>958</ele></trkpt><trkpt lat="40.947935" lon="20.779949"><ele>954</ele></trkpt><trkpt lat="40.947657" lon="20.779974"><ele>952</ele></trkpt><trkpt lat="40.947329" lon="20.780138"><ele>950</ele></trkpt><trkpt lat="40.947014" lon="20.780191"><ele>945</ele></trkpt><trkpt lat="40.946462" lon="20.780178"><ele>933</ele></trkpt><trkpt lat="40.946264" lon="20.780304"><ele>929</ele></trkpt><trkpt lat="40.946138" lon="20.780595"><ele>926</ele></trkpt><trkpt lat="40.946038" lon="20.781114"><ele>920</ele></trkpt><tr