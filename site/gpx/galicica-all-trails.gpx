<trk><name>MTB-2: near Velestovo to Dva Javora</name><desc>MTB-2 is one of Galičica National Park's mountain bike trails, several of which link the hiking routes. It runs 19.0 km from near Velestovo to Dva Javora, climbing about 652 m and descending 189 m in the direction drawn, between 1,024 m and 1,555 m.</desc><type>MTB</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>DarkBlue</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>24357F</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.087773" lon="20.828056"><ele>1028</ele></trkpt><trkpt lat="41.088329" lon="20.827961"><ele>1024</ele></trkpt><trkpt lat="41.088518" lon="20.829194"><ele>1038</ele></trkpt><trkpt lat="41.088779" lon="20.829461"><ele>1041</ele></trkpt><trkpt lat="41.089340" lon="20.828830"><ele>1035</ele></trkpt><trkpt lat="41.090999" lon="20.829372"><ele>1050</ele></trkpt><trkpt lat="41.093494" lon="20.830968"><ele>1081</ele></trkpt><trkpt lat="41.094829" lon="20.832668"><ele>1104</ele></trkpt><trkpt lat="41.096138" lon="20.832206"><ele>1102</ele></trkpt><trkpt lat="41.096732" lon="20.832242"><ele>1110</ele></trkpt><trkpt lat="41.098314" lon="20.833225"><ele>1128</ele></trkpt><trkpt lat="41.098860" lon="20.833837"><ele>1134</ele></trkpt><trkpt lat="41.098639" lon="20.835074"><ele>1147</ele></trkpt><trkpt lat="41.098651" lon="20.835845"><ele>1153</ele></trkpt><trkpt lat="41.098901" lon="20.836462"><ele>1150</ele></trkpt><trkpt lat="41.098853" lon="20.837197"><ele>1159</ele></trkpt><trkpt lat="41.098116" lon="20.837010"><ele>1164</ele></trkpt><trkpt lat="41.097959" lon="20.836512"><ele>1165</ele></trkpt><trkpt lat="41.097634" lon="20.836400"><ele>1167</ele></trkpt><trkpt lat="41.096931" lon="20.836666"><ele>1180</ele></trkpt><trkpt lat="41.096384" lon="20.835854"><ele>1173</ele></trkpt><trkpt lat="41.095421" lon="20.835546"><ele>1179</ele></trkpt><trkpt lat="41.094787" lon="20.836368"><ele>1193</ele></trkpt><trkpt lat