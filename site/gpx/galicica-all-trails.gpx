<trk><name>MTB-7: the MTB-2 junction to Tomoros peak</name><desc>MTB-7 is one of Galičica National Park's mountain bike trails, several of which link the hiking routes. It runs 2.7 km from the MTB-2 junction to Tomoros peak, climbing about 235 m and descending 5 m in the direction drawn, between 1,428 m and 1,667 m.</desc><type>MTB</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>DarkBlue</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>24357F</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="40.998520" lon="20.869287"><ele>1436</ele></trkpt><trkpt lat="40.998700" lon="20.869327"><ele>1434</ele></trkpt><trkpt lat="40.998700" lon="20.869328"><ele>1434</ele></trkpt><trkpt lat="40.998701" lon="20.869328"><ele>1434</ele></trkpt><trkpt lat="40.998701" lon="20.869327"><ele>1434</ele></trkpt><trkpt lat="40.998761" lon="20.869407"><ele>1433</ele></trkpt><trkpt lat="40.998803" lon="20.869376"><ele>1432</ele></trkpt><trkpt lat="40.998837" lon="20.869378"><ele>1432</ele></trkpt><trkpt lat="40.999067" lon="20.869364"><ele>1431</ele></trkpt><trkpt lat="40.999270" lon="20.869482"><ele>1432</ele></trkpt><trkpt lat="40.999485" lon="20.869605"><ele>1433</ele></trkpt><trkpt lat="40.999624" lon="20.869704"><ele>1431</ele></trkpt><trkpt lat="40.999683" lon="20.869688"><ele>1430</ele></trkpt><trkpt lat="40.999800" lon="20.869719"><ele>1429</ele></trkpt><trkpt lat="40.999999" lon="20.869833"><ele>1428</ele></trkpt><trkpt lat="41.000229" lon="20.870010"><ele>1431</ele></trkpt><trkpt lat="41.000368" lon="20.870130"><ele>1433</ele></trkpt><trkpt lat="41.000611" lon="20.870381"><ele>1434</ele></trkpt><trkpt lat="41.000786" lon="20.870594"><ele>1436</ele></trkpt><trkpt lat="41.000966" lon="20.870839"><ele>1436</ele></trkpt><trkpt lat="41.001132" lon="20.871132"><ele>1439</ele></trkpt><trkpt lat="41.001295" lon="20.871360"><ele>1436</ele></trkpt><trkpt lat="41.001502" lon="20.871610"><ele>1434</ele></trkpt><