<trk><name>H-4: the MTB-3 junction to the T-1 junction</name><desc>H-4 is one of Galičica National Park's easier and shorter hiking trails. It runs 5.4 km from the MTB-3 junction to the T-1 junction, climbing about 46 m and descending 107 m in the direction drawn, between 1,419 m and 1,498 m.</desc><type>H</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>Red</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>C8202F</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.072524" lon="20.864067"><ele>1489</ele></trkpt><trkpt lat="41.072673" lon="20.864458"><ele>1487</ele></trkpt><trkpt lat="41.073024" lon="20.864756"><ele>1492</ele></trkpt><trkpt lat="41.074235" lon="20.864633"><ele>1490</ele></trkpt><trkpt lat="41.075349" lon="20.865085"><ele>1488</ele></trkpt><trkpt lat="41.076594" lon="20.866395"><ele>1485</ele></trkpt><trkpt lat="41.077305" lon="20.866883"><ele>1485</ele></trkpt><trkpt lat="41.077787" lon="20.867627"><ele>1490</ele></trkpt><trkpt lat="41.078547" lon="20.867784"><ele>1488</ele></trkpt><trkpt lat="41.078764" lon="20.868066"><ele>1491</ele></trkpt><trkpt lat="41.078706" lon="20.868074"><ele>1490</ele></trkpt><trkpt lat="41.079114" lon="20.868449"><ele>1493</ele></trkpt><trkpt lat="41.079751" lon="20.868706"><ele>1495</ele></trkpt><trkpt lat="41.079746" lon="20.868706"><ele>1495</ele></trkpt><trkpt lat="41.080016" lon="20.868968"><ele>1496</ele></trkpt><trkpt lat="41.080372" lon="20.869079"><ele>1498</ele></trkpt><trkpt lat="41.080585" lon="20.868940"><ele>1498</ele></trkpt><trkpt lat="41.080743" lon="20.868442"><ele>1497</ele></trkpt><trkpt lat="41.081043" lon="20.868143"><ele>1495</ele></trkpt><trkpt lat="41.082991" lon="20.868115"><ele>1490</ele></trkpt><trkpt lat="41.084267" lon="20.867928"><ele>1494</ele></trkpt><trkpt lat="41.085137" lon="20.868026"><ele>1492</ele></trkpt><trkpt lat="41.086328" lon="20.867843"><ele>1491</ele></trkpt><trkpt lat="41.086514" lon="20.8