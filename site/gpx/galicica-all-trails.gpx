<trk><name>T-5: Elshani to the G-5 junction</name><desc>T-5 is one of Galičica National Park's harder and longer hiking trails, with more climbing. It runs 3.7 km from Elshani to the G-5 junction, climbing about 654 m and descending 0 m in the direction drawn, between 887 m and 1,547 m.</desc><type>T</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>DarkGreen</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>1F7A3D</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.026367" lon="20.817080"><ele>887</ele></trkpt><trkpt lat="41.026809" lon="20.817757"><ele>898</ele></trkpt><trkpt lat="41.026938" lon="20.818278"><ele>907</ele></trkpt><trkpt lat="41.027017" lon="20.818909"><ele>916</ele></trkpt><trkpt lat="41.026984" lon="20.819101"><ele>920</ele></trkpt><trkpt lat="41.027252" lon="20.819671"><ele>933</ele></trkpt><trkpt lat="41.027210" lon="20.819813"><ele>937</ele></trkpt><trkpt lat="41.027101" lon="20.819845"><ele>939</ele></trkpt><trkpt lat="41.026946" lon="20.819746"><ele>937</ele></trkpt><trkpt lat="41.026878" lon="20.819835"><ele>943</ele></trkpt><trkpt lat="41.026797" lon="20.819913"><ele>949</ele></trkpt><trkpt lat="41.026764" lon="20.819891"><ele>950</ele></trkpt><trkpt lat="41.026665" lon="20.819875"><ele>952</ele></trkpt><trkpt lat="41.026620" lon="20.820000"><ele>955</ele></trkpt><trkpt lat="41.026712" lon="20.820255"><ele>961</ele></trkpt><trkpt lat="41.026714" lon="20.820268"><ele>961</ele></trkpt><trkpt lat="41.026694" lon="20.820270"><ele>962</ele></trkpt><trkpt lat="41.026824" lon="20.820608"><ele>969</ele></trkpt><trkpt lat="41.026839" lon="20.820622"><ele>969</ele></trkpt><trkpt lat="41.026861" lon="20.820597"><ele>969</ele></trkpt><trkpt lat="41.026995" lon="20.820678"><ele>973</ele></trkpt><trkpt lat="41.027010" lon="20.821002"><ele>984</ele></trkpt><trkpt lat="41.027063" lon="20.820914"><ele>980</ele></trkpt><trkpt lat="41.027101" lon="20.821112"><ele>987</ele></