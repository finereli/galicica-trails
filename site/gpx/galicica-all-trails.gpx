<trk><name>MTB-1: Ramne to the Ohrid visitor centre</name><desc>MTB-1 is one of Galičica National Park's mountain bike trails, several of which link the hiking routes. It runs 2.5 km from Ramne to the Ohrid visitor centre, climbing about 0 m and descending 193 m in the direction drawn, between 770 m and 965 m.</desc><type>MTB</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>DarkBlue</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>24357F</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.109305" lon="20.836922"><ele>965</ele></trkpt><trkpt lat="41.109298" lon="20.836886"><ele>965</ele></trkpt><trkpt lat="41.109238" lon="20.836697"><ele>963</ele></trkpt><trkpt lat="41.109210" lon="20.836595"><ele>962</ele></trkpt><trkpt lat="41.109158" lon="20.836490"><ele>962</ele></trkpt><trkpt lat="41.109156" lon="20.836484"><ele>961</ele></trkpt><trkpt lat="41.109031" lon="20.836436"><ele>963</ele></trkpt><trkpt lat="41.108929" lon="20.836354"><ele>964</ele></trkpt><trkpt lat="41.108883" lon="20.836179"><ele>961</ele></trkpt><trkpt lat="41.108882" lon="20.836165"><ele>961</ele></trkpt><trkpt lat="41.108761" lon="20.836049"><ele>961</ele></trkpt><trkpt lat="41.108685" lon="20.835953"><ele>961</ele></trkpt><trkpt lat="41.108660" lon="20.835781"><ele>958</ele></trkpt><trkpt lat="41.108648" lon="20.835600"><ele>954</ele></trkpt><trkpt lat="41.108593" lon="20.835442"><ele>952</ele></trkpt><trkpt lat="41.108548" lon="20.835262"><ele>950</ele></trkpt><trkpt lat="41.108518" lon="20.835060"><ele>946</ele></trkpt><trkpt lat="41.108496" lon="20.835004"><ele>946</ele></trkpt><trkpt lat="41.108442" lon="20.834949"><ele>946</ele></trkpt><trkpt lat="41.108363" lon="20.834906"><ele>946</ele></trkpt><trkpt lat="41.108214" lon="20.834849"><ele>947</ele></trkpt><trkpt lat="41.108104" lon="20.834804"><ele>948</ele></trkpt><trkpt lat="41.107982" lon="20.834768"><ele>950</ele></trkpt><trkpt lat="41.107948" lon="20