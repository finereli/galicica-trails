<trk><name>G-4: Sharbojca mountain house (Asan Djura) to Goga peak</name><desc>G-4 is one of Galičica National Park's high ridge trails above 1,600 m. It's 2.7 km from Sharbojca mountain house (Asan Djura) to Goga peak, with about 255 m of climbing and 0 m of descent in the direction drawn, between 1,467 m and 1,726 m.</desc><type>G</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>Yellow</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>D4A20B</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.027939" lon="20.865588"><ele>1467</ele></trkpt><trkpt lat="41.028268" lon="20.866368"><ele>1481</ele></trkpt><trkpt lat="41.028282" lon="20.867172"><ele>1485</ele></trkpt><trkpt lat="41.028431" lon="20.867848"><ele>1489</ele></trkpt><trkpt lat="41.028407" lon="20.868176"><ele>1491</ele></trkpt><trkpt lat="41.028309" lon="20.868532"><ele>1493</ele></trkpt><trkpt lat="41.028284" lon="20.869378"><ele>1503</ele></trkpt><trkpt lat="41.028268" lon="20.869821"><ele>1510</ele></trkpt><trkpt lat="41.028303" lon="20.870447"><ele>1520</ele></trkpt><trkpt lat="41.028396" lon="20.870480"><ele>1520</ele></trkpt><trkpt lat="41.028594" lon="20.870959"><ele>1530</ele></trkpt><trkpt lat="41.028583" lon="20.870963"><ele>1531</ele></trkpt><trkpt lat="41.028581" lon="20.870969"><ele>1531</ele></trkpt><trkpt lat="41.028652" lon="20.871266"><ele>1534</ele></trkpt><trkpt lat="41.028713" lon="20.871785"><ele>1537</ele></trkpt><trkpt lat="41.028781" lon="20.871953"><ele>1537</ele></trkpt><trkpt lat="41.028976" lon="20.872547"><ele>1542</ele></trkpt><trkpt lat="41.028819" lon="20.872733"><ele>1544</ele></trkpt><trkpt lat="41.028840" lon="20.872902"><ele>1544</ele></trkpt><trkpt lat="41.028800" lon="20.873112"><ele>1546</ele></trkpt><trkpt lat="41.028766" lon="20.873663"><ele>1553</ele></trkpt><trkpt lat="41.028773" lon="20.873757"><ele>1555</ele></trkpt><trkpt lat="41.028434" lon="20.874028"><ele>1557</ele></trkpt><t