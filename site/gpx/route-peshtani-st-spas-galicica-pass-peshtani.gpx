<trk><name>MTB-6: near Peshtani (746 m) to above Trpejca (1,147 m)</name><desc>MTB-6 is one of Galičica National Park's mountain bike trails, several of which link the hiking routes. It runs 6.3 km from near Peshtani (746 m) to above Trpejca (1,147 m), climbing about 426 m and descending 31 m in the direction drawn, between 746 m and 1,149 m.</desc><type>MTB</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>DarkBlue</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>24357F</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.008760" lon="20.805979"><ele>746</ele></trkpt><trkpt lat="41.008738" lon="20.806023"><ele>747</ele></trkpt><trkpt lat="41.008777" lon="20.806164"><ele>750</ele></trkpt><trkpt lat="41.008801" lon="20.806193"><ele>750</ele></trkpt><trkpt lat="41.008829" lon="20.806197"><ele>750</ele></trkpt><trkpt lat="41.008815" lon="20.806217"><ele>750</ele></trkpt><trkpt lat="41.008831" lon="20.806234"><ele>750</ele></trkpt><trkpt lat="41.009024" lon="20.806469"><ele>753</ele></trkpt><trkpt lat="41.009063" lon="20.806435"><ele>752</ele></trkpt><trkpt lat="41.009016" lon="20.806670"><ele>756</ele></trkpt><trkpt lat="41.008895" lon="20.806673"><ele>757</ele></trkpt><trkpt lat="41.008912" lon="20.806616"><ele>756</ele></trkpt><trkpt lat="41.008913" lon="20.806615"><ele>756</ele></trkpt><trkpt lat="41.008664" lon="20.806541"><ele>758</ele></trkpt><trkpt lat="41.008368" lon="20.806573"><ele>760</ele></trkpt><trkpt lat="41.008096" lon="20.806468"><ele>761</ele></trkpt><trkpt lat="41.008101" lon="20.806488"><ele>761</ele></trkpt><trkpt lat="41.007815" lon="20.806454"><ele>762</ele></trkpt><trkpt lat="41.007477" lon="20.806538"><ele>765</ele></trkpt><trkpt lat="41.007104" lon="20.806638"><ele>763</ele></trkpt><trkpt lat="41.006980" lon="20.806814"><ele>765</ele></trkpt><trkpt lat="41.007255" lon="20.807829"><ele>778</ele></trkpt><trkpt lat="41.007258" lon="20.807956"><ele>779</ele></trk