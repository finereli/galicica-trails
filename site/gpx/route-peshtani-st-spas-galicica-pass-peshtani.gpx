<trk><name>H-9: Peshtani to the MTB-6 junction</name><desc>H-9 is one of Galičica National Park's easier and shorter hiking trails. It runs 2.2 km from Peshtani to the MTB-6 junction, climbing about 231 m and descending 0 m in the direction drawn, between 697 m and 930 m.</desc><type>H</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>Red</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>C8202F</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.015725" lon="20.810024"><ele>697</ele></trkpt><trkpt lat="41.015726" lon="20.810039"><ele>697</ele></trkpt><trkpt lat="41.015650" lon="20.810123"><ele>697</ele></trkpt><trkpt lat="41.015343" lon="20.810585"><ele>699</ele></trkpt><trkpt lat="41.014056" lon="20.811670"><ele>715</ele></trkpt><trkpt lat="41.013962" lon="20.812252"><ele>718</ele></trkpt><trkpt lat="41.013720" lon="20.812075"><ele>723</ele></trkpt><trkpt lat="41.013292" lon="20.812273"><ele>736</ele></trkpt><trkpt lat="41.013006" lon="20.812135"><ele>740</ele></trkpt><trkpt lat="41.012462" lon="20.812346"><ele>750</ele></trkpt><trkpt lat="41.012233" lon="20.812601"><ele>753</ele></trkpt><trkpt lat="41.011410" lon="20.812709"><ele>763</ele></trkpt><trkpt lat="41.011518" lon="20.812748"><ele>760</ele></trkpt><trkpt lat="41.010559" lon="20.813306"><ele>781</ele></trkpt><trkpt lat="41.010480" lon="20.813220"><ele>783</ele></trkpt><trkpt lat="41.010305" lon="20.813680"><ele>796</ele></trkpt><trkpt lat="41.010074" lon="20.813482"><ele>803</ele></trkpt><trkpt lat="41.009671" lon="20.813435"><ele>817</ele></trkpt><trkpt lat="41.009380" lon="20.813104"><ele>822</ele></trkpt><trkpt lat="41.008464" lon="20.812867"><ele>833</ele></trkpt><trkpt lat="41.008439" lon="20.812887"><ele>833</ele></trkpt><trkpt lat="41.008307" lon="20.813017"><ele>834</ele></trkpt><trkpt lat="41.008066" lon="20.812948"><ele>833</ele></trkpt><trkpt lat="41.007089" lon="20.814204"><ele>847</ele></trkpt><trkpt lat="41.