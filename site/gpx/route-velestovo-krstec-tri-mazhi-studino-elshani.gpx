<trk><name>T-4: near Velestovo to above Leskoec (1,508 m)</name><desc>T-4 is one of Galičica National Park's harder and longer hiking trails, with more climbing. It's 14.0 km from near Velestovo to above Leskoec (1,508 m), with about 651 m of climbing and 202 m of descent in the direction drawn, between 1,053 m and 1,666 m.</desc><type>T</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>DarkGreen</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>1F7A3D</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.081239" lon="20.825730"><ele>1053</ele></trkpt><trkpt lat="41.081223" lon="20.826735"><ele>1070</ele></trkpt><trkpt lat="41.080647" lon="20.827234"><ele>1079</ele></trkpt><trkpt lat="41.080217" lon="20.827004"><ele>1078</ele></trkpt><trkpt lat="41.079873" lon="20.826652"><ele>1076</ele></trkpt><trkpt lat="41.079406" lon="20.826744"><ele>1070</ele></trkpt><trkpt lat="41.079095" lon="20.827450"><ele>1076</ele></trkpt><trkpt lat="41.078474" lon="20.826896"><ele>1076</ele></trkpt><trkpt lat="41.077916" lon="20.826165"><ele>1059</ele></trkpt><trkpt lat="41.077670" lon="20.826612"><ele>1068</ele></trkpt><trkpt lat="41.076886" lon="20.827280"><ele>1059</ele></trkpt><trkpt lat="41.076487" lon="20.827710"><ele>1059</ele></trkpt><trkpt lat="41.075881" lon="20.828210"><ele>1069</ele></trkpt><trkpt lat="41.074804" lon="20.828820"><ele>1082</ele></trkpt><trkpt lat="41.073759" lon="20.828806"><ele>1085</ele></trkpt><trkpt lat="41.071984" lon="20.828180"><ele>1099</ele></trkpt><trkpt lat="41.071785" lon="20.828190"><ele>1100</ele></trkpt><trkpt lat="41.071240" lon="20.828754"><ele>1115</ele></trkpt><trkpt lat="41.070711" lon="20.829075"><ele>1126</ele></trkpt><trkpt lat="41.070887" lon="20.828522"><ele>1116</ele></trkpt><trkpt lat="41.070826" lon="20.828295"><ele>1114</ele></trkpt><trkpt lat="41.070351" lon="20.828178"><ele>1121</ele></trkpt><trkpt lat="41.069220" lon="20.828322"><ele>1136</ele></