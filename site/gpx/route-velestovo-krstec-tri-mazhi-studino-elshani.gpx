<trk><name>G-5: the T-4 junction to Galičica pass (Lipova Livada)</name><desc>G-5 is one of Galičica National Park's high ridge trails above 1,600 m. It's 10.1 km from the T-4 junction to Galičica pass (Lipova Livada), with about 658 m of climbing and 630 m of descent in the direction drawn, between 1,542 m and 1,975 m.</desc><type>G</type><extensions><gpxx:TrackExtension><gpxx:DisplayColor>Yellow</gpxx:DisplayColor></gpxx:TrackExtension><gpx_style:line><gpx_style:color>D4A20B</gpx_style:color><gpx_style:width>4</gpx_style:width></gpx_style:line></extensions><trkseg><trkpt lat="41.014847" lon="20.845897"><ele>1549</ele></trkpt><trkpt lat="41.015084" lon="20.845422"><ele>1550</ele></trkpt><trkpt lat="41.015355" lon="20.845161"><ele>1545</ele></trkpt><trkpt lat="41.015451" lon="20.845189"><ele>1542</ele></trkpt><trkpt lat="41.015692" lon="20.844814"><ele>1547</ele></trkpt><trkpt lat="41.015941" lon="20.844703"><ele>1545</ele></trkpt><trkpt lat="41.016157" lon="20.844393"><ele>1544</ele></trkpt><trkpt lat="41.015995" lon="20.844010"><ele>1551</ele></trkpt><trkpt lat="41.015652" lon="20.843544"><ele>1563</ele></trkpt><trkpt lat="41.015789" lon="20.843376"><ele>1556</ele></trkpt><trkpt lat="41.015705" lon="20.843199"><ele>1557</ele></trkpt><trkpt lat="41.015765" lon="20.843101"><ele>1555</ele></trkpt><trkpt lat="41.015767" lon="20.843099"><ele>1555</ele></trkpt><trkpt lat="41.015773" lon="20.843077"><ele>1555</ele></trkpt><trkpt lat="41.015620" lon="20.843070"><ele>1558</ele></trkpt><trkpt lat="41.015397" lon="20.842893"><ele>1560</ele></trkpt><trkpt lat="41.015313" lon="20.842880"><ele>1562</ele></trkpt><trkpt lat="41.015131" lon="20.842393"><ele>1560</ele></trkpt><trkpt lat="41.014851" lon="20.842360"><ele>1563</ele></trkpt><trkpt lat="41.014659" lon="20.842006"><ele>1561</ele></trkpt><trkpt lat="41.014626" lon="20.842019"><ele>1560</ele></trkpt><trkpt lat="41.014630" lon="20.841894"><ele>1561</ele></trkpt><trkpt lat="41.014301" lon="20.841465"><ele>1555</ele></trkpt><